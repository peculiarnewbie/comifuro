{
    "name": "comifuro",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter www dev",
        "build": "pnpm --filter www build",
        "check": "vp check",
        "typecheck": "pnpm -r typecheck",
        "deploy": "vp exec alchemy deploy packages/www/alchemy.run.ts",
        "destroy": "vp exec alchemy destroy packages/www/alchemy.run.ts",
        "scrape": "pnpm --filter twitter-scraper run scrape",
        "scrape:max-id": "pnpm --filter twitter-scraper run scrape:max-id",
        "fmt": "vp fmt",
        "lint": "vp lint",
        "test": "bun test packages/core/src packages/twitter-scraper/src packages/www/src/lib && pnpm test:d1",
        "test:backend": "bun test packages/core/src packages/twitter-scraper/src && pnpm test:d1",
        "test:d1": "tsx --test packages/core/src/scraper-d1.integration.ts",
        "scrape:status": "pnpm --filter twitter-scraper run scrape --status",
        "test:browser": "tsx --test packages/twitter-scraper/src/browser.integration.ts",
        "test:map": "tsx --test packages/www/tests/map.browser.integration.ts"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "alchemy": "catalog:",
        "effect": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
        "vite-plus": "catalog:",
        "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
    },
    "packageManager": "pnpm@10.33.0"
}
